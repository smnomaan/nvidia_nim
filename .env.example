# NVIDIA NGC key used to pull and run the NIM container.
NGC_API_KEY=nvapi-your-key-here
NVIDIA_API_KEY=nvapi-your-key-here

NIM_BASE_URL=http://localhost:8000/v1
NIM_MODEL=meta/llama-3.1-8b-instruct
NIM_IMAGE=nvcr.io/nim/meta/llama-3.1-8b-instruct@sha256:4c912ccaf0d9ddf84a230df2dc196b4e68be882a29974429dbec58808374cfc0

# Direct local runs default to CUDA. Compose overrides this to CPU so NIM owns
# the workstation's single GPU.
EMBEDDING_DEVICE=cuda

# Optional LangSmith tracing. Keep disabled for local evaluation runs.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nvidia-nim-rag
